# Copie para .env e ajuste o que precisar. Tudo aqui é opcional: sem .env valem os padrões abaixo.

# Portas expostas na máquina
API_PORT=8080
POSTGRES_PORT=5436

# Banco de dados
POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina

# ADMIN criado na primeira subida
ADMIN_EMAIL=admin@oficina.com
ADMIN_SENHA=admin12345

# Segredos da aplicação (Base64). Sem eles, a API usa chaves de desenvolvimento.
# Gere com: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# JWT_SECRET=
# CRYPTO_KEY=
# CRYPTO_INDEX_KEY=
